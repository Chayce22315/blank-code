<Window x:Class="BlankCode.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="blank code" Width="1440" Height="900" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI">
<Grid>
<Grid x:Name="WelcomeView">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="30,20"><DockPanel>
  <StackPanel Orientation="Horizontal"><Border Width="34" Height="34" Background="#2C2119" CornerRadius="10" Margin="0,0,12,0"><TextBlock Text="◇" Foreground="{StaticResource Accent}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="blank code" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="make the idea real." FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
  <Button DockPanel.Dock="Right" Content="sign in ↗" Click="ShowAuth_Click" VerticalAlignment="Center"/>
 </DockPanel></Border>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="1040" Margin="36,48,36,44" HorizontalAlignment="Center">
  <Border Background="#292018" BorderBrush="#4C3524" BorderThickness="1" CornerRadius="20" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,20"><TextBlock Text="✦  your next idea starts here" Foreground="{StaticResource Accent}" FontSize="12"/></Border>
  <TextBlock Text="let’s build&#10;something real." FontSize="48" FontWeight="SemiBold" LineHeight="54"/>
  <TextBlock Text="a coding workspace that helps you go from idea to working software. your projects stay on your machine." FontSize="16" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="650" Margin="0,16,0,34" LineHeight="25"/>
  <UniformGrid Columns="3" Margin="0,0,0,28">
   <Button Click="CreateProject_Click" HorizontalContentAlignment="Stretch" Padding="18" Height="150" Margin="0,0,10,0"><StackPanel><TextBlock Text="＋" FontSize="27" Foreground="{StaticResource Accent}" Margin="0,0,0,13"/><TextBlock Text="new project" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="start with an empty folder" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Button>
   <Button Click="OpenFolder_Click" HorizontalContentAlignment="Stretch" Padding="18" Height="150" Margin="5,0"><StackPanel><TextBlock Text="▱" FontSize="27" Foreground="{StaticResource Accent}" Margin="0,0,0,13"/><TextBlock Text="open a folder" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="jump into work you already have" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Button>
   <Button Click="SampleProject_Click" HorizontalContentAlignment="Stretch" Padding="18" Height="150" Margin="10,0,0,0"><StackPanel><TextBlock Text="✧" FontSize="27" Foreground="{StaticResource Accent}" Margin="0,0,0,13"/><TextBlock Text="try a sample" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="open a tiny project to explore" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Button>
  </UniformGrid>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="recent projects" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="RecentProjectsText" Text="nothing here yet. your next project can be the first." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
   <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="10,0,0,0"><StackPanel><TextBlock Text="start your way" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="no account required for local projects. sign in can be added when you need cloud features." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/><Button Content="account &amp; sign-in options →" HorizontalAlignment="Left" Click="ShowAuth_Click" Margin="0,12,0,0" Padding="0,5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Accent}"/></StackPanel></Border>
  </Grid>
  <Border Background="#17171C" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18"><DockPanel><TextBlock Text="⌘" FontSize="24" Foreground="{StaticResource Accent}" Margin="0,0,14,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="built for the whole journey" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="write code, work with an ai assistant, inspect output, and iterate. we’re building this in layers." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
 </StackPanel></ScrollViewer>
 <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="30,12"><DockPanel><TextBlock Text="blank code · local-first by default" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock DockPanel.Dock="Right" Text="windows preview · early build" Foreground="{StaticResource Muted}" FontSize="11"/></DockPanel></Border>
</Grid>
<Grid x:Name="AuthView" Visibility="Collapsed">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,16"><DockPanel><Button Content="← back" Click="BackToWelcome_Click" Padding="10,7"/><TextBlock Text="account" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0"/></DockPanel></Border>
 <StackPanel Grid.Row="1" Width="430" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
  <TextBlock Text="your account, your call." FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
  <TextBlock Text="local projects work without signing in. account connections will unlock cloud features when they’re ready." FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,24" LineHeight="20"/>
  <Button Content="continue with github" Click="AuthProvider_Click" Tag="github" Padding="14,13" Margin="0,0,0,10"/>
  <Button Content="continue with google" Click="AuthProvider_Click" Tag="google" Padding="14,13" Margin="0,0,0,18"/>
  <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18"><StackPanel>
   <TextBlock Text="email sign-in" FontWeight="SemiBold" FontSize="14"/>
   <TextBlock Text="email and password fields are shown for the planned flow. authentication is not wired up yet, so no credentials are collected or stored." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14" LineHeight="18"/>
   <TextBox x:Name="EmailInput" Text="email address" Margin="0,0,0,10"/>
   <PasswordBox x:Name="PasswordInput" Background="#121216" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}" Padding="12,10" FontSize="13" Margin="0,0,0,12"/>
   <Button Content="sign in / create account" Click="EmailAuth_Click" Style="{StaticResource Primary}"/>
  </StackPanel></Border>
  <TextBlock Text="no fake logins. oauth, secure token storage, and hosted auth will be connected after the provider is configured." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="17"/>
 </StackPanel>
</Grid>
<Grid x:Name="WorkspaceView" Visibility="Collapsed">
 <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
 <Border Grid.Row="0" Background="#17171C" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,0"><DockPanel>
  <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"><Border Width="24" Height="24" Background="#2C2119" CornerRadius="7" Margin="0,0,10,0"><TextBlock Text="◇" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border><TextBlock Text="blank code" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,22,0"/><Button Content="open folder" Padding="10,5" Click="OpenFolder_Click" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"/><Button Content="save" Padding="10,5" Click="SaveFile_Click" Background="Transparent" BorderThickness="0"/></StackPanel>
  <TextBlock x:Name="ProjectTitleText" Text="untitled project" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><Button DockPanel.Dock="Right" Content="home" Click="BackToWelcome_Click" Padding="10,5" Margin="10,0,0,0"/>
 </DockPanel></Border>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#17171C" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><StackPanel Margin="0,12"><Button Content="▤" ToolTip="explorer" Padding="0,12" Background="Transparent" BorderThickness="0"/><Button Content="⌕" ToolTip="search preview" Padding="0,12" Background="Transparent" BorderThickness="0" Click="SearchInfo_Click"/><Button Content="⌘" ToolTip="source control preview" Padding="0,12" Background="Transparent" BorderThickness="0" Click="GitInfo_Click"/><Button Content="✧" ToolTip="assistant" Padding="0,12" Background="Transparent" BorderThickness="0" Click="FocusAssistant_Click"/></StackPanel></Border>
  <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="explorer" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,4,0,14"/><TextBlock x:Name="ExplorerRootText" DockPanel.Dock="Top" Text="project" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,8"/><ListBox x:Name="FileList" SelectionChanged="FileList_SelectionChanged"/></DockPanel></Border>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="#17171C" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,0"><DockPanel><TextBlock x:Name="ActiveFileText" Text="welcome.md" VerticalAlignment="Center" FontSize="12"/><Button DockPanel.Dock="Right" Content="save" Click="SaveFile_Click" Padding="8,4" Margin="0,5"/></DockPanel></Border>
   <TextBox x:Name="EditorText" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="#111114" FontFamily="Cascadia Code, Consolas" FontSize="13" Padding="18" TextChanged="EditorText_TextChanged"/>
   <Grid Grid.Row="2" Background="#17171C"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="12,0"><DockPanel><TextBlock Text="terminal / output" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="preview panel" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource Muted}"/></DockPanel></Border><TextBox x:Name="OutputText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="#141418" FontFamily="Cascadia Code, Consolas" FontSize="12" Padding="12" Text="blank code workspace ready.&#10;choose a file from the explorer to begin editing.&#10;&#10;the integrated terminal and build runner are not connected in this preview."/></Grid>
  </Grid>
  <Border Grid.Column="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,2,0,16"><TextBlock Text="✧  assistant" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="plan, build, and iterate" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel VerticalAlignment="Top"><Border Background="#222229" CornerRadius="10" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="ready when you are." FontSize="13" FontWeight="SemiBold"/><TextBlock Text="this is a ui shell. connect a model provider to enable coding actions." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="18"/></StackPanel></Border><TextBox x:Name="AssistantPrompt" MinHeight="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" ToolTip="describe what you want to build" Text="what are we building?"/><Button Content="send prompt ↗" Click="AssistantPreview_Click" Style="{StaticResource Primary}" Margin="0,10,0,0"/><TextBlock Text="model: not connected" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel></DockPanel></Border>
 </Grid>
 <Border Grid.Row="2" Background="#202027" Padding="12,0"><DockPanel><TextBlock x:Name="StatusText" Text="ready" FontSize="10" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="local workspace · no account required" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel></Border>
</Grid>
</Grid>
</Window>
